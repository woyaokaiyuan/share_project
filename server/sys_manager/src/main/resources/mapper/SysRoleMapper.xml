<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luwq.mapper.SysRoleMapper">

    <resultMap id="BaseResultMap" type="com.luwq.entity.SysRole">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, code, description, status, create_time, update_time
    </sql>

    <sql id="Query_Where">
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="code != null and code != ''">
                AND code LIKE CONCAT('%', #{code}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_role
        <include refid="Query_Where"/>
        ORDER BY create_time DESC, id DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(1) FROM sys_role
        <include refid="Query_Where"/>
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_role
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="role.id">
        INSERT INTO sys_role (name, code, description, status)
        VALUES (#{role.name}, #{role.code}, #{role.description}, #{role.status})
    </insert>

    <update id="update">
        UPDATE sys_role
        <set>
            name = #{role.name},
            code = #{role.code},
            description = #{role.description},
            status = #{role.status}
        </set>
        WHERE id = #{role.id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_role WHERE id = #{id}
    </delete>

    <select id="countByCode" resultType="long">
        SELECT COUNT(1) FROM sys_role
        WHERE code = #{code}
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

</mapper>
