<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luwq.mapper.SysRolePermissionMapper">

    <select id="selectPermissionIdsByRoleId" resultType="java.lang.Integer">
        SELECT permission_id FROM sys_role_permission WHERE role_id = #{roleId}
    </select>

    <delete id="deleteByRoleId">
        DELETE FROM sys_role_permission WHERE role_id = #{roleId}
    </delete>

    <insert id="batchInsert">
        INSERT INTO sys_role_permission (role_id, permission_id) VALUES
        <foreach collection="permissionIds" item="permissionId" separator=",">
            (#{roleId}, #{permissionId})
        </foreach>
    </insert>

    <select id="selectUserIdsByPermissionId" resultType="java.lang.String">
        SELECT DISTINCT ur.user_id
        FROM sys_user_role ur
        INNER JOIN sys_role_permission rp ON ur.role_id = rp.role_id
        WHERE rp.permission_id = #{permissionId}
    </select>

</mapper>
