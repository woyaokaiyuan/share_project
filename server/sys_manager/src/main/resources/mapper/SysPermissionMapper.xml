<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luwq.mapper.SysPermissionMapper">

    <resultMap id="BaseResultMap" type="com.luwq.entity.SysPermission">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="parent_id" property="parentId"/>
        <result column="type" property="type"/>
        <result column="module" property="module"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, code, parent_id, type, module, sort, status, create_time, update_time
    </sql>

    <sql id="Query_Where">
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="code != null and code != ''">
                AND code LIKE CONCAT('%', #{code}, '%')
            </if>
        </where>
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_permission
        <include refid="Query_Where"/>
        ORDER BY parent_id, sort, id
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_permission
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="permission.id">
        INSERT INTO sys_permission (name, code, parent_id, type, module, sort, status)
        VALUES (#{permission.name}, #{permission.code}, #{permission.parentId},
                #{permission.type}, #{permission.module}, #{permission.sort}, #{permission.status})
    </insert>

    <update id="update">
        UPDATE sys_permission
        <set>
            name = #{permission.name},
            code = #{permission.code},
            parent_id = #{permission.parentId},
            type = #{permission.type},
            module = #{permission.module},
            sort = #{permission.sort},
            status = #{permission.status}
        </set>
        WHERE id = #{permission.id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_permission WHERE id = #{id}
    </delete>

    <select id="countByCode" resultType="long">
        SELECT COUNT(1) FROM sys_permission
        WHERE code = #{code}
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

    <select id="countChildren" resultType="long">
        SELECT COUNT(1) FROM sys_permission WHERE parent_id = #{parentId}
    </select>

</mapper>
